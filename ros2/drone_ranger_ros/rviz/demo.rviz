Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground grid (10 m)
      Enabled: true
      Cell Size: 10
      Plane Cell Count: 40
      Plane: XY
      Color: 160; 160; 164
      Alpha: 0.4
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF frames
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 4
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Flight path
      Enabled: true
      Topic:
        Value: /odometry
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Filter size: 10
      Keep: 60
      Position Tolerance: 4
      Angle Tolerance: 0.2
      Shape:
        Value: Axes
        Axes Length: 1.5
        Axes Radius: 0.12
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracked objects (ellipse, range line, label)
      Enabled: true
      Topic:
        Value: /markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Namespaces:
        ellipse: true
        label: true
        range: true
      Value: true
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /image
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 34; 36; 42
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Name: Current View
      Target Frame: base_link
      Distance: 95
      Focal Point:
        X: 15
        Y: 0
        Z: -20
      Focal Shape Fixed Size: false
      Focal Shape Size: 0.05
      Near Clip Distance: 0.01
      Pitch: 1.0
      Yaw: 3.14159
      Value: ThirdPersonFollower (rviz_default_plugins)
    Saved: ~
Window Geometry:
  # the camera image docked on the left, 616 px wide (QMainWindow State, saved by RViz)
  Camera:
    collapsed: false
  Height: 720
  Width: 1280
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd00000001000000000000026800000275fc0200000001fb0000000c00430061006d006500720061010000003e000002750000001600ffffff000002920000027500000004000000040000000800000008fc0000000100000002000000010000000a0054006f006f006c00730100000000ffffffff0000000000000000
  X: 0
  Y: 0
