{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "results/multi_drone/schema.json",
 "title": "Phase 14 and Phase 16 multi-drone search simulation results (D-752, D-764)",
 "description": "One schema per kind of file in results/multi_drone/. x-files maps each file-name pattern to its definition (the first matching pattern applies); tests/test_results_schema.py checks every file against it. Times are seconds, rates per km2 or per drone per second as named; probabilities are 0 to 1; ci95 values are [low, high] 95 % bootstrap intervals over seeds (searches) unless named otherwise.",
 "x-files": {
  "phase16_paired_*.json": "#/$defs/phase16_paired",
  "phase16_sensitivity_seeds.json": "#/$defs/phase16_seeds",
  "phase16_sensitivity.json": "#/$defs/phase16_sensitivity",
  "phase16_*_seeds.json": "#/$defs/phase16_seeds",
  "phase16_*.json": "#/$defs/phase16_stage",
  "clutter_*.json": "#/$defs/clutter",
  "bytes_*.json": "#/$defs/bytes",
  "sensor_*.json": "#/$defs/sensor",
  "design_check_*.json": "#/$defs/design_check",
  "design_*.json": "#/$defs/stage",
  "test_*_seeds.json": "#/$defs/seeds",
  "test_*.json": "#/$defs/stage",
  "budget_check_*_seeds.json": "#/$defs/seeds",
  "budget_check_*.json": "#/$defs/stage"
 },
 "$defs": {
  "interval": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "probability": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "sensor": {
   "description": "Camera model measured from a frozen run's outputs (scripts/multidrone_sensor_fit.py): per camera height, detection probability per pass and false alarms per km2 searched.",
   "type": "object",
   "required": [
    "name",
    "split",
    "sequences",
    "group",
    "min_depression_deg",
    "pass_split_gap_frames",
    "n_boot",
    "by_height"
   ],
   "properties": {
    "name": {
     "type": "string"
    },
    "split": {
     "type": "string"
    },
    "sequences": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "group": {
     "type": "string"
    },
    "min_depression_deg": {
     "type": "number"
    },
    "pass_split_gap_frames": {
     "type": "integer"
    },
    "n_boot": {
     "type": "integer"
    },
    "by_height": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "n_passes",
       "n_people",
       "pd_per_pass",
       "pd_by_pass_frames",
       "false_alarms_per_km2",
       "ground_searched_km2"
      ],
      "properties": {
       "n_passes": {
        "type": "integer",
        "minimum": 0
       },
       "n_people": {
        "type": "integer",
        "minimum": 0
       },
       "pd_per_pass": {
        "$ref": "#/$defs/probability"
       },
       "pd_ci95_resample_sequences": {
        "type": [
         "array",
         "null"
        ],
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2,
        "description": "null when the sensor comes from one sequence per height (the rural Town07 model), so sequences cannot be resampled"
       },
       "pass_frames_quartiles": {
        "type": "array",
        "items": {
         "type": "number"
        }
       },
       "pd_by_pass_frames": {
        "type": "object",
        "description": "Bins of frames in view, (a, b], keyed 'a-b'.",
        "additionalProperties": {
         "type": "object",
         "required": [
          "n",
          "pd"
         ],
         "properties": {
          "n": {
           "type": "integer"
          },
          "pd": {
           "$ref": "#/$defs/probability"
          }
         }
        }
       },
       "box_h_px_median": {
        "type": [
         "number",
         "null"
        ]
       },
       "false_alarms_per_km2": {
        "type": "number",
        "minimum": 0
       },
       "false_alarm_tracks": {
        "type": "integer",
        "minimum": 0
       },
       "ground_searched_km2": {
        "type": "number",
        "minimum": 0
       },
       "range_half_68_m_median": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "summary": {
   "description": "One configuration over its seeds (scripts/multidrone_run.py summarise).",
   "type": "object",
   "required": [
    "n_seeds",
    "T1_s",
    "horizon_s",
    "p_found_by_T1",
    "p_found_by_horizon",
    "restricted_mean_time_s",
    "false_alarms_before_find_mean",
    "repeated_coverage",
    "bytes_per_drone_s_mean",
    "ci95",
    "curve_t_s",
    "curve_p_found"
   ],
   "properties": {
    "n_seeds": {
     "type": "integer",
     "minimum": 1
    },
    "T1_s": {
     "type": "number",
     "minimum": 0,
     "description": "Time for the fleet to sweep the area once."
    },
    "horizon_s": {
     "type": "number",
     "minimum": 0,
     "description": "3 x T1; searches without a find count as this."
    },
    "p_found_by_T1": {
     "$ref": "#/$defs/probability"
    },
    "p_found_by_horizon": {
     "$ref": "#/$defs/probability"
    },
    "restricted_mean_time_s": {
     "type": "number",
     "minimum": 0
    },
    "false_alarms_before_find_mean": {
     "type": "number",
     "minimum": 0
    },
    "repeated_coverage": {
     "$ref": "#/$defs/probability"
    },
    "bytes_per_drone_s_mean": {
     "type": "number",
     "minimum": 0
    },
    "ci95": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/interval"
     }
    },
    "curve_t_s": {
     "type": "array",
     "items": {
      "type": "number"
     }
    },
    "curve_p_found": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/probability"
     }
    }
   }
  },
  "paired": {
   "description": "Configuration minus reference on the same seeds.",
   "type": "object",
   "required": [
    "restricted_mean_time_diff_s",
    "restricted_mean_time_diff_ci95",
    "p_found_by_T1_diff",
    "p_found_by_T1_diff_ci95"
   ],
   "properties": {
    "restricted_mean_time_diff_s": {
     "type": "number"
    },
    "restricted_mean_time_diff_ci95": {
     "$ref": "#/$defs/interval"
    },
    "p_found_by_T1_diff": {
     "type": "number"
    },
    "p_found_by_T1_diff_ci95": {
     "$ref": "#/$defs/interval"
    }
   }
  },
  "stage": {
   "description": "A stage of runs: design (development seeds 0..199), test (10000..10299, once) or the budget check (development seeds, D-756).",
   "type": "object",
   "required": [
    "stage",
    "sensor",
    "settings",
    "seeds",
    "results",
    "paired"
   ],
   "properties": {
    "stage": {
     "type": "string"
    },
    "sensor": {
     "type": "string"
    },
    "settings": {
     "type": "object"
    },
    "seeds": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "configs": {
     "type": "object"
    },
    "results": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/summary"
     }
    },
    "paired": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": {
       "$ref": "#/$defs/paired"
      }
     }
    },
    "not_run": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    }
   }
  },
  "seeds": {
   "description": "Per-seed outcomes of each configuration: time of the find, or the horizon when found is false.",
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "t_s",
     "found"
    ],
    "properties": {
     "seed": {
      "type": "array",
      "items": {
       "type": "integer"
      }
     },
     "t_s": {
      "type": "array",
      "items": {
       "type": "number"
      }
     },
     "found": {
      "type": "array",
      "items": {
       "type": "boolean"
      }
     }
    }
   }
  },
  "design_check": {
   "description": "scripts/multidrone_design_check.py (development seeds): paired 4 minus 8 lanes, and mean time to find (rmt, s) and repeated coverage with false alarms on or off and detection probability by pass length or constant.",
   "type": "object",
   "required": [
    "paired_b4_minus_b8"
   ],
   "properties": {
    "paired_b4_minus_b8": {
     "type": "object",
     "required": [
      "mean_s",
      "ci95"
     ],
     "properties": {
      "mean_s": {
       "type": "number"
      },
      "ci95": {
       "$ref": "#/$defs/interval"
      }
     }
    }
   },
   "additionalProperties": {
    "type": "object",
    "required": [
     "rmt",
     "repeat"
    ],
    "properties": {
     "rmt": {
      "type": "number"
     },
     "repeat": {
      "$ref": "#/$defs/probability"
     }
    }
   }
  },
  "bytes": {
   "type": "object",
   "required": [
    "broadcasts_per_observation",
    "bytes_per_drone_per_second",
    "cells_per_observation",
    "configuration",
    "detections_per_observation",
    "n_drones",
    "runs_per_observation",
    "seeds",
    "sensor",
    "share_of_bytes",
    "share_of_observation_bytes"
   ],
   "properties": {
    "broadcasts_per_observation": {
     "type": "number"
    },
    "bytes_per_drone_per_second": {
     "type": "number",
     "minimum": 0
    },
    "cells_per_observation": {
     "type": "number"
    },
    "configuration": {
     "type": "string"
    },
    "detections_per_observation": {
     "type": "number"
    },
    "n_drones": {
     "type": "integer",
     "minimum": 0
    },
    "runs_per_observation": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     }
    },
    "seeds": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    },
    "sensor": {
     "type": "string"
    },
    "share_of_bytes": {
     "type": "object",
     "required": [
      "cell_runs",
      "claims",
      "detections",
      "observation_header",
      "packet_header_vector"
     ],
     "properties": {
      "cell_runs": {
       "type": "number"
      },
      "claims": {
       "type": "number"
      },
      "detections": {
       "type": "number"
      },
      "observation_header": {
       "type": "number"
      },
      "packet_header_vector": {
       "type": "number"
      }
     }
    },
    "share_of_observation_bytes": {
     "type": "object",
     "required": [
      "own",
      "relayed"
     ],
     "properties": {
      "own": {
       "type": "number"
      },
      "relayed": {
       "type": "number"
      }
     }
    }
   },
   "description": "Where Phase 14's sharing bytes go, by part and by origin (scripts/multidrone_bytes.py, Phase 16 stage 0, D-764; development seeds)."
  },
  "clutter": {
   "type": "object",
   "required": [
    "by_min_track_frames",
    "ground_searched_km2",
    "height_m",
    "name",
    "pass_split_gap_frames",
    "persistence_values",
    "radius_m",
    "radius_rule",
    "sequences",
    "split"
   ],
   "properties": {
    "by_min_track_frames": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "false_alarm_tracks",
       "false_alarms_per_km2",
       "min_track_frames",
       "pass_correlation",
       "pd_by_pass_frames",
       "recurrence",
       "track_life_median_frames"
      ],
      "properties": {
       "false_alarm_tracks": {
        "type": "integer"
       },
       "false_alarms_per_km2": {
        "type": "number",
        "minimum": 0
       },
       "min_track_frames": {
        "type": "integer",
        "minimum": 0
       },
       "pass_correlation": {
        "type": "object",
        "required": [
         "after_detected",
         "after_missed",
         "n_pairs",
         "n_passes",
         "pd_per_pass"
        ],
        "properties": {
         "after_detected": {
          "type": "object"
         },
         "after_missed": {
          "type": "object"
         },
         "n_pairs": {
          "type": "integer",
          "minimum": 0
         },
         "n_passes": {
          "type": "integer",
          "minimum": 0
         },
         "pd_per_pass": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
         }
        }
       },
       "pd_by_pass_frames": {
        "type": "object",
        "additionalProperties": {
         "type": "object"
        }
       },
       "recurrence": {
        "type": "object",
        "additionalProperties": {
         "type": "object"
        }
       },
       "track_life_median_frames": {
        "type": "object",
        "required": [
         "false_alarm",
         "person"
        ],
        "properties": {
         "false_alarm": {
          "type": "number"
         },
         "person": {
          "type": "number"
         }
        }
       }
      }
     }
    },
    "ground_searched_km2": {
     "type": "number",
     "minimum": 0
    },
    "height_m": {
     "type": "integer",
     "minimum": 0
    },
    "name": {
     "type": "string"
    },
    "pass_split_gap_frames": {
     "type": "integer",
     "minimum": 0
    },
    "persistence_values": {
     "type": "object",
     "required": [
      "m",
      "rule"
     ],
     "properties": {
      "m": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      },
      "rule": {
       "type": "string"
      }
     }
    },
    "radius_m": {
     "type": "number"
    },
    "radius_rule": {
     "type": "string"
    },
    "sequences": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "split": {
     "type": "string"
    }
   },
   "description": "False-alarm recurrence at a site on later passes, pass-to-pass correlation of person detection, and persistence-filter refits, at 20 m (scripts/multidrone_clutter_fit.py, D-764). by_min_track_frames is keyed by the filter's minimum track life in frames; recurrence by radius in metres. persistent: the two-kind maximum-likelihood fit (share of false alarms from look-alikes, their chance of firing on each later pass)."
  },
  "phase16_summary": {
   "description": "One Phase 16 configuration over its seeds (scripts/multidrone16_run.py summary): Phase 14's summary, with times to a confirmed find, crew alarms before it, and the same measures for the first detection of the person.",
   "type": "object",
   "required": [
    "n_seeds",
    "T1_s",
    "horizon_s",
    "p_found_by_T1",
    "p_found_by_horizon",
    "restricted_mean_time_s",
    "false_alarms_before_find_mean",
    "repeated_coverage",
    "bytes_per_drone_s_mean",
    "ci95",
    "curve_t_s",
    "curve_p_found",
    "crew_alarms_before_find_mean",
    "first_detection"
   ],
   "properties": {
    "n_seeds": {
     "type": "integer",
     "minimum": 1
    },
    "T1_s": {
     "type": "number",
     "minimum": 0,
     "description": "Time for the fleet to sweep the area once."
    },
    "horizon_s": {
     "type": "number",
     "minimum": 0,
     "description": "3 x T1; searches without a find count as this."
    },
    "p_found_by_T1": {
     "$ref": "#/$defs/probability"
    },
    "p_found_by_horizon": {
     "$ref": "#/$defs/probability"
    },
    "restricted_mean_time_s": {
     "type": "number",
     "minimum": 0
    },
    "false_alarms_before_find_mean": {
     "type": "number",
     "minimum": 0
    },
    "repeated_coverage": {
     "$ref": "#/$defs/probability"
    },
    "bytes_per_drone_s_mean": {
     "type": "number",
     "minimum": 0
    },
    "ci95": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/interval"
     }
    },
    "curve_t_s": {
     "type": "array",
     "items": {
      "type": "number"
     }
    },
    "curve_p_found": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/probability"
     }
    },
    "crew_alarms_before_find_mean": {
     "type": "number",
     "minimum": 0,
     "description": "Places confirmed (k detections within the radius) that were not the person, before the find."
    },
    "first_detection": {
     "type": "object",
     "required": [
      "restricted_mean_time_s",
      "p_found_by_T1",
      "p_found_by_horizon",
      "ci95"
     ],
     "properties": {
      "restricted_mean_time_s": {
       "type": "number",
       "minimum": 0
      },
      "p_found_by_T1": {
       "$ref": "#/$defs/probability"
      },
      "p_found_by_horizon": {
       "$ref": "#/$defs/probability"
      },
      "ci95": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/interval"
       }
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "phase16_stage": {
   "description": "A Phase 16 stage of searches (scripts/multidrone16_run.py, D-764): design1, design2, design3 (development seeds 0..199) or test (20000..20299, once).",
   "type": "object",
   "required": [
    "stage",
    "seeds",
    "settings",
    "phase14_settings",
    "choice",
    "results"
   ],
   "properties": {
    "stage": {
     "type": "string",
     "description": "design1, design2, design3 or test."
    },
    "seeds": {
     "type": "array",
     "items": {
      "type": "integer"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "settings": {
     "type": "object",
     "description": "Label -> configuration (camera, n drones, confirm k, min track frames m, planner config pc, and for loss runs the radio and lost drone)."
    },
    "phase14_settings": {
     "type": "object"
    },
    "choice": {
     "type": "object",
     "description": "Design stages: the choice by the rule fixed in D-764/D-765; empty for the test.",
     "properties": {
      "best": {
       "type": "string"
      },
      "tied_with_best": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "chosen": {
       "type": "string"
      },
      "minus_best": {
       "type": "object",
       "additionalProperties": {
        "$ref": "#/$defs/paired"
       }
      }
     }
    },
    "results": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/phase16_summary"
     }
    }
   },
   "additionalProperties": false
  },
  "phase16_seeds": {
   "description": "Per-seed outcomes of each Phase 16 configuration, label -> list of searches.",
   "type": "object",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "object",
     "required": [
      "seed",
      "found",
      "t",
      "first_found",
      "first_t",
      "horizon",
      "crew_before",
      "fa_before",
      "passes",
      "repeat",
      "bytes",
      "steps",
      "n"
     ],
     "properties": {
      "seed": {
       "type": "integer"
      },
      "found": {
       "type": "boolean",
       "description": "A confirmed alarm was the person."
      },
      "t": {
       "type": [
        "number",
        "null"
       ],
       "description": "Time of the confirmed find, s (null when none)."
      },
      "first_found": {
       "type": "boolean"
      },
      "first_t": {
       "type": [
        "number",
        "null"
       ],
       "description": "Time of the first detection of the person, s (null when none)."
      },
      "horizon": {
       "type": "number",
       "minimum": 0
      },
      "crew_before": {
       "type": "integer",
       "minimum": 0
      },
      "fa_before": {
       "type": "integer",
       "minimum": 0
      },
      "passes": {
       "type": "integer",
       "minimum": 0
      },
      "repeat": {
       "type": "integer",
       "minimum": 0
      },
      "bytes": {
       "type": "number",
       "minimum": 0
      },
      "steps": {
       "type": "integer",
       "minimum": 0
      },
      "n": {
       "type": "integer",
       "minimum": 1
      }
     }
    }
   }
  },
  "phase16_paired": {
   "description": "Paired comparisons for H13 to H16 (scripts/multidrone16_paired.py, D-765): each is a minus b on the same seeds (a cost comparison subtracts a0 and b0 first), with 95 % bootstrap intervals over seeds.",
   "type": "object",
   "required": [
    "stage",
    "n_boot",
    "comparisons"
   ],
   "properties": {
    "stage": {
     "type": "string"
    },
    "n_boot": {
     "type": "integer",
     "minimum": 1
    },
    "comparisons": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "required": [
       "a",
       "b",
       "time",
       "crew",
       "bytes"
      ],
      "properties": {
       "a": {
        "type": "string"
       },
       "b": {
        "type": "string"
       },
       "a0": {
        "type": "string"
       },
       "b0": {
        "type": "string"
       },
       "time": {
        "type": "object",
        "required": [
         "mean",
         "ci95",
         "excludes_0"
        ],
        "properties": {
         "mean": {
          "type": "number"
         },
         "ci95": {
          "$ref": "#/$defs/interval"
